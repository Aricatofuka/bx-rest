    "generate-typings": "node scripts/generate-typings.mjs",
    "build": "npm run generate-typings && tsc -p tsconfig.json"
  },
  "dependencies": {
    "bx-rest": "file:../../dist/bx-rest",
    "rxjs": "^7.8.1",
    "typescript": "~5.5.4"
  },
  "devDependencies": {
    "monaco-editor": "^0.52.0",
    "@types/node": "^22.20.1"
  }
}
